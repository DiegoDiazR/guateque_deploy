<!--
    Paquete de CSS/JS (app.<hash>.css / app.<hash>.js, generado con php scripts/build_assets.php).
    El nombre cambia cuando cambia el contenido, asi que se puede guardar en el navegador 1 anio.
    Ver docs/RENDIMIENTO.md.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>
  </system.webServer>
</configuration>
