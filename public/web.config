<!--
    Rewrites requires Microsoft URL Rewrite Module for IIS
    Download: https://www.iis.net/downloads/microsoft/url-rewrite
    Debug Help: https://docs.microsoft.com/en-us/iis/extensions/url-rewrite-module/using-failed-request-tracing-to-trace-rewrite-rules
-->
<configuration>
  <system.webServer>

    <!--
        RENDIMIENTO (ver docs/RENDIMIENTO.md)

        1) Compresion gzip de lo que sale del servidor. Sin esto el navegador baja ~2.5 MB de JS/CSS
           sin comprimir en cada pantalla. doStaticCompression comprime CSS/JS/JSON/SVG ya existentes
           (y los guarda comprimidos en cache del servidor); doDynamicCompression comprime el HTML y
           las respuestas JSON de Laravel. Requiere que esten instaladas las funciones de IIS
           "Compresion de contenido estatico" y "Compresion de contenido dinamico"; si no lo estan,
           IIS ignora estas dos lineas (no da error). Los tipos MIME comprimidos se configuran en el
           servidor (httpCompression, solo en applicationHost.config, no se puede aqui).
    -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <staticContent>
      <!--
          2) Cache del navegador para archivos estaticos (imagenes, fuentes, librerias de terceros):
             7 dias, asi no se vuelven a pedir en cada pagina. Los JS/CSS propios del sistema se
             piden con ?v=<fecha del archivo> y el paquete theme/dist tiene el hash en el nombre,
             por lo que un despliegue nuevo se ve de inmediato aunque el navegador tenga cache.
             theme/dist usa 1 anio (ver public/theme/dist/web.config).
      -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />

      <!--
          3) Tipo MIME de .woff2 (fuentes Font Awesome, Rubik, Inter, Source Serif). IIS 8.5 o anterior no lo
             trae y respondia 404 al pedirlas. Se quita antes de agregar para no fallar si ya existe.
      -->
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <rewrite>
      <rules>
        <rule name="Imported Rule 1" stopProcessing="true">
          <match url="^(.*)/$" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
          </conditions>
          <action type="Redirect" redirectType="Permanent" url="/{R:1}" />
        </rule>
        <rule name="Imported Rule 2" stopProcessing="true">
          <match url="^" ignoreCase="false" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" ignoreCase="false" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" ignoreCase="false" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
