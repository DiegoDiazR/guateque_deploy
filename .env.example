APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dislexia
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Identidad del municipio (encabezado, login, pie de pagina, titulo y colores).
# NORMALMENTE NO HACE FALTA NADA: cada municipio ve su nombre y su escudo porque el sistema los lee de la
# tabla `parametros` de su propia base de datos (alcaldia, logo, direccion, ubicacion, nit).
# Estas variables solo sirven para forzar o sobrescribir un dato. Orden: .env > perfil de
# config/municipio.php > parametros > valor por omision. Despues de cambiar el .env en produccion:
#     php artisan config:clear   (o config:cache)
# Ver docs/MULTIMUNICIPIO.md. Las rutas de imagenes son relativas a public/.
#
# Municipio forzado (paipa, guateque, sutatenza, lacapilla, santarosa, villadeleyva, sesquile). Recomendado
# solo si se quiere que el login se vea bien aun con la base de datos caida y la cache vacia.
#MUNICIPIO=guateque
#MUNICIPIO_CIUDAD=Guateque
#MUNICIPIO_DEPARTAMENTO=Boyaca
#MUNICIPIO_ALCALDIA="Alcaldia de Guateque"
#MUNICIPIO_SECRETARIA="Secretaria de Hacienda"
#MUNICIPIO_DEPENDENCIA="Direccion de Impuestos"
#MUNICIPIO_SISTEMA="Impuesto Predial Unificado"
#MUNICIPIO_NIT="800.013.683-9"
#MUNICIPIO_COLOR="#1fa49d"
#MUNICIPIO_COLOR_OSCURO="#17756f"
#MUNICIPIO_COLOR_ACENTO="#c99a2e"
# Imagen del encabezado que ya trae el nombre escrito (solo Paipa la tiene), escudo del pie y favicon, foto del login
#MUNICIPIO_LOGO=img/paipa/logo-paipa-full.png
#MUNICIPIO_ESCUDO=img/paipa/escudo-paipa.png
#MUNICIPIO_FONDO=img/paipa/fondo-paipa.jpg
# Contacto del pie: solo se imprime lo que tenga valor (una variable definida pero vacia borra ese dato)
#MUNICIPIO_TELEFONO="318 530 9285"
#MUNICIPIO_CORREO=impuestos@paipa-boyaca.gov.co
#MUNICIPIO_DIRECCION="Carrera 22 # 25-14, primer piso"
#MUNICIPIO_HORARIO="(horario de atencion, tal como debe verse en el pie)"
#MUNICIPIO_PORTAL=https://psepaipa.erpsoftsas.com
#MUNICIPIO_PORTAL_TEXTO="Pago en linea del Impuesto Predial"
#MUNICIPIO_ENLACES={"Texto del enlace":"https://..."}
